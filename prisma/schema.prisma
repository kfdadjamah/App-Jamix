generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisateur {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  createdAt      DateTime @default(now())
  bar            Bar?
}

model Bar {
  id             String       @id @default(cuid())
  nom            String
  adresse        String
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  organisateurId String       @unique
  organisateur   Organisateur @relation(fields: [organisateurId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}
