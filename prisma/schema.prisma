generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisateur {
  id                     String                  @id @default(cuid())
  // Prénom et nom, deux champs distincts. `prenom` est null pour les comptes antérieurs à la
  // phase 42 ; leur `nom` peut alors contenir l'ancien « Prénom Nom » (jamais coupé automatiquement).
  // `nom` est null pour les comptes antérieurs à la phase 35.
  prenom                 String?
  nom                    String?
  email                  String                  @unique
  motDePasseHash         String
  // Toute session émise avant cette date est rejetée ; null = aucune invalidation.
  motDePasseModifieLe    DateTime?
  createdAt              DateTime                @default(now())
  bars                   Bar[]
  jetonsReinitialisation JetonReinitialisation[]
}

// Seul le hash SHA-256 du jeton est stocké, jamais le jeton brut envoyé par email.
model JetonReinitialisation {
  id             String       @id @default(cuid())
  hash           String       @unique
  organisateurId String
  organisateur   Organisateur @relation(fields: [organisateurId], references: [id], onDelete: Cascade)
  expireLe       DateTime
  createdAt      DateTime     @default(now())

  @@index([organisateurId])
}

model Bar {
  id             String       @id @default(cuid())
  nom            String
  adresse        String
  // Code postal à part (« 69002 ») ; vide pour un bar antérieur qui ne l'avait pas renseigné.
  codePostal     String       @default("")
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  organisateurId String
  organisateur   Organisateur @relation(fields: [organisateurId], references: [id])
  annonces       Annonce[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Filet de sécurité : les doublons sont détectés côté application, comparaison normalisée.
  @@unique([organisateurId, nom, adresse])
  @@index([organisateurId])
}

enum StatutAnnonce {
  BROUILLON
  PUBLIEE
}

// Rythme d'une annonce récurrente (phases 60 et 61).
enum RythmeRecurrence {
  CHAQUE_SEMAINE
  UNE_SEMAINE_SUR_DEUX
  MENSUEL
}

enum StatutOccurrence {
  CONFIRMEE
  PROGRAMMEE
  EN_ATTENTE_CONFIRMATION
  ANNULEE
}

model Annonce {
  id              String          @id @default(cuid())
  barId           String
  bar             Bar             @relation(fields: [barId], references: [id])
  statut          StatutAnnonce   @default(BROUILLON)
  estRecurrente   Boolean         @default(false)
  styles          String[]
  styleAutre      String?
  instruments     String[]
  instrumentAutre String?
  // Texte brut, 500 caractères maximum (phase 29).
  description     String?
  // Prénom d'un co-organisateur, 40 caractères maximum (phase 57) ; champ de l'annonce (toutes ses dates).
  coOrganisateur  String?
  photoUrl1       String?
  photoUrl2       String?
  // Règle de récurrence (phases 59 à 63) : absente sur les annonces antérieures et les jams
  // exceptionnelles ; `estRecurrente` reste la source du type. jourSemaine : 1 = lundi … 7 = dimanche ;
  // semaineDuMois : 1 à 4, -1 = dernier. Une date retirée n'est pas recréée par la règle.
  rythme          RythmeRecurrence?
  jourSemaine     Int?
  semaineDuMois   Int?
  debutRecurrence DateTime?       @db.Date
  finRecurrence   DateTime?       @db.Date
  datesRetirees   DateTime[]      @db.Date
  // Écrit une seule fois, au passage Brouillon → Publiée.
  publieeLe       DateTime?
  occurrences     OccurrenceJam[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model OccurrenceJam {
  id             String           @id @default(cuid())
  annonceId      String
  annonce        Annonce          @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  date           DateTime         @db.Date
  heureDebut     String
  heureFin       String?
  statut         StatutOccurrence @default(CONFIRMEE)
  confirmationJ7 DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([annonceId, date])
}

// Un envoi réussi du formulaire Contact, pour limiter les envois par connexion.
// Seule une empreinte HMAC-SHA-256 de l'IP est stockée, jamais l'IP brute ;
// les lignes de plus de 24 h sont purgées à chaque envoi.
model EnvoiContact {
  id          String   @id @default(cuid())
  empreinteIp String
  creeLe      DateTime @default(now())

  @@index([empreinteIp, creeLe])
}
