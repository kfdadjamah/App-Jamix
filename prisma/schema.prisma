generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisateur {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  // Toute session émise avant cette date est rejetée ; null = aucune invalidation.
  motDePasseModifieLe DateTime?
  createdAt      DateTime @default(now())
  bars           Bar[]
  jetonsReinitialisation JetonReinitialisation[]
}

// Seul le hash SHA-256 du jeton est stocké, jamais le jeton brut envoyé par email.
model JetonReinitialisation {
  id             String       @id @default(cuid())
  hash           String       @unique
  organisateurId String
  organisateur   Organisateur @relation(fields: [organisateurId], references: [id], onDelete: Cascade)
  expireLe       DateTime
  createdAt      DateTime     @default(now())

  @@index([organisateurId])
}

model Bar {
  id             String       @id @default(cuid())
  nom            String
  adresse        String
  latitude       Float?
  longitude      Float?
  photoUrl       String?
  organisateurId String
  organisateur   Organisateur @relation(fields: [organisateurId], references: [id])
  annonces       Annonce[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Filet de sécurité : les doublons sont détectés côté application, comparaison normalisée.
  @@unique([organisateurId, nom, adresse])
  @@index([organisateurId])
}

enum StatutAnnonce {
  BROUILLON
  PUBLIEE
}

enum StatutOccurrence {
  CONFIRMEE
  PROGRAMMEE
  EN_ATTENTE_CONFIRMATION
  ANNULEE
}

model Annonce {
  id             String           @id @default(cuid())
  barId          String
  bar            Bar              @relation(fields: [barId], references: [id])
  statut         StatutAnnonce    @default(BROUILLON)
  estRecurrente  Boolean          @default(false)
  styles         String[]
  styleAutre     String?
  instruments    String[]
  instrumentAutre String?
  // Texte brut, 500 caractères maximum (phase 29).
  description    String?
  photoUrl1      String?
  photoUrl2      String?
  // Écrit une seule fois, au passage Brouillon → Publiée.
  publieeLe      DateTime?
  occurrences    OccurrenceJam[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model OccurrenceJam {
  id              String           @id @default(cuid())
  annonceId       String
  annonce         Annonce          @relation(fields: [annonceId], references: [id], onDelete: Cascade)
  date            DateTime         @db.Date
  heureDebut      String
  heureFin        String?
  statut          StatutOccurrence @default(CONFIRMEE)
  confirmationJ7  DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([annonceId, date])
}
